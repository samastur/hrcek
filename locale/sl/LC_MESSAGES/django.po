"Email templates are out of date: %(names)s. Run: uv run python manage.py "
"compile_emails"
msgstr ""
"E-poštne predloge niso posodobljene: %(names)s. Zaženite: uv run python "
"manage.py compile_emails"

#: src/hrcek/accounts/management/commands/compile_emails.py
