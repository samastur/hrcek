<mjml>
  <mj-include path="_head.mjml" />
  <mj-body>
    <mj-include path="_header.mjml" />
    <mj-section>
      <mj-column>
        <mj-text mj-class="heading">{% trans "Reset your password" %}</mj-text>
        <mj-text>{% trans "Use the button below to choose a new password for your Hrček account." %}</mj-text>
        <mj-button href="{{ reset_url }}">{% trans "Choose a new password" %}</mj-button>
        <mj-text mj-class="muted">{% trans "If you did not ask for this, ignore this message and nothing will change." %}</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_footer.mjml" />
  </mj-body>
</mjml>
