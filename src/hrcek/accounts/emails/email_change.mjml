<mjml>
  <mj-include path="_head.mjml" />
  <mj-body>
    <mj-include path="_header.mjml" />
    <mj-section>
      <mj-column>
        <mj-text mj-class="heading">{% trans "Confirm your new email address" %}</mj-text>
        <mj-text>{% trans "Confirm this address to finish moving your Hrček account to it. Until you do, your current address keeps working." %}</mj-text>
        <mj-button href="{{ confirm_url }}">{% trans "Confirm this address" %}</mj-button>
        <mj-text mj-class="muted">{% blocktrans %}This link stops working in {{ expires_hours }} hours.{% endblocktrans %}</mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="_footer.mjml" />
  </mj-body>
</mjml>
