#: src/hrcek/accounts/errors.py
msgid "The email address or password is not correct."
msgstr "E-poštni naslov ali geslo ni pravilno."

#: src/hrcek/accounts/errors.py
msgid "Confirm your email address before signing in."
msgstr "Pred prijavo potrdite svoj e-poštni naslov."

#: src/hrcek/accounts/errors.py
msgid "You must sign in to do that."
msgstr "Za to dejanje se morate prijaviti."

#: src/hrcek/accounts/errors.py
msgid "This API token is invalid or has expired."
msgstr "Ta API-žeton ni veljaven ali je potekel."

#: src/hrcek/accounts/errors.py
msgid "The request could not be verified. Try again."
msgstr "Zahteve ni bilo mogoče preveriti. Poskusite znova."

#: src/hrcek/accounts/errors.py
msgid "This invitation link is not valid. It may have expired or been used."
msgstr ""
"Ta povezava za povabilo ni veljavna. Morda je potekla ali bila že "
"uporabljena."

#: src/hrcek/accounts/errors.py
msgid "That display name is already taken."
msgstr "To prikazno ime je že zasedeno."

#: src/hrcek/accounts/forms.py
msgid "Display name"
msgstr "Prikazno ime"

#: src/hrcek/accounts/forms.py
msgid "Optional. You can sign in with this instead of your email."
msgstr "Neobvezno. S tem se lahko prijavite namesto z e-poštnim naslovom."

#: src/hrcek/accounts/forms.py
msgid "Password"
msgstr "Geslo"

#: src/hrcek/accounts/forms.py
msgid "Repeat password"
msgstr "Ponovite geslo"

#: src/hrcek/accounts/forms.py
msgid "The two passwords do not match."
msgstr "Gesli se ne ujemata."

#: src/hrcek/accounts/management/commands/compile_emails.py
#, python-format
